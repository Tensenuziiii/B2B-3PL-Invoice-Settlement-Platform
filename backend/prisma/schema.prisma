generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  DISPATCH_MANAGER
  DRIVER
  AUDITOR
  ACCOUNTS
  CLIENT_AP
  VENDOR_3PL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

// Spec §16
enum TripStatus {
  ASSIGNED
  IN_PROGRESS
  DELIVERY_IN_PROGRESS
  DELIVERED
  AUDIT_PENDING
  CORRECTION_REQUESTED
  AUDITED
  READY_FOR_BILLING
}

enum TripStopStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  FAILED
}

enum PodDocumentType {
  PHOTO
  SIGNATURE
  LR
  OTHER
}

// Spec §29
enum InvoiceStatus {
  DRAFT
  SUBMITTED
  CLIENT_REVIEW
  APPROVED
  PAYMENT_QUEUED
  PAID
  REJECTED
  DISPUTED
  CANCELLED
  OVERDUE
}

// Spec §24
enum AuditOutcome {
  AUDITED
  CORRECTION_REQUESTED
}

enum CollectionMode {
  COD
  CASH
  UPI
  CREDIT
}

enum ExpenseType {
  FUEL
  TOLL
  PARKING
  DRIVER_ALLOWANCE
  EMERGENCY_FUEL
  REPAIR
  OTHER
}

enum NotificationType {
  TRIP
  AUDIT
  INVOICE
  DISPUTE
  PAYMENT
  SETTLEMENT
  INVITATION
}

enum RateType {
  FIXED_TRIP
  PER_DELIVERY
  PER_KM
}

enum CounterpartyType {
  CLIENT
  VENDOR
}

// ============================================================
// TENANT ROOT
// ============================================================

model Organization {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  legalName  String?
  gstin      String?
  pan        String?
  stateCode  String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  users             User[]
  refreshTokens     RefreshToken[]
  loginAttempts     LoginAttempt[]
  auditLogs         AuditLog[]
  invitations       Invitation[]
  counters          Counter[]

  vehicles          Vehicle[]
  drivers           Driver[]
  clients           Client[]
  vendors           Vendor[]
  routes            Route[]
  rateCards         RateCard[]
  rateCardItems     RateCardItem[]
  trips             Trip[]
  tripStops         TripStop[]
  podDocuments      PodDocument[]
  collections       Collection[]
  tripExpenses      TripExpense[]
  eodTally          EodTally[]
  auditReviews      AuditReview[]
  invoices          Invoice[]
  invoiceLines      InvoiceLine[]
  payments          Payment[]
  notifications     Notification[]

  @@index([status])
}

// ============================================================
// IDENTITY & ACCESS
// ============================================================

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  organizationId      String     @db.Uuid
  organization        Organization @relation(fields: [organizationId], references: [id])
  email               String     @unique
  passwordHash        String?
  name                String
  initials            String     @default("VL")
  role                Role
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?  @db.Timestamptz(6)
  displayId           String
  hubName             String?
  clientId            String?    @db.Uuid
  client              Client?    @relation(fields: [clientId], references: [id])
  createdAt           DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?  @db.Timestamptz(6)

  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  loginAttempts      LoginAttempt[]

  @@index([organizationId])
  @@index([role, status])
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  tokenHash      String    @unique
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id])
  expiresAt      DateTime  @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  familyId       String?
  replacedBy     String?
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([organizationId])
  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String
  role           Role
  tokenHash      String    @unique
  expiresAt      DateTime  @db.Timestamptz(6)
  acceptedAt     DateTime? @db.Timestamptz(6)
  invitedById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([organizationId])
  @@index([email])
}

model LoginAttempt {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  email          String
  userId         String?   @db.Uuid
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  succeeded      Boolean   @default(false)
  failureReason  String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([organizationId])
}

// ============================================================
// COUNTERS  (org-scoped human-readable IDs, spec §11)
// ============================================================

model Counter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  entityType     String   // "TRIP" | "INVOICE" | "DISPUTE" | "SETTLEMENT"
  period         String   // "202610"
  lastValue      Int      @default(0)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, entityType, period])
  @@index([organizationId])
}

// ============================================================
// MASTER DATA
// ============================================================

model Client {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id])
  name             String
  code             String
  gstin            String?
  stateCode        String?
  paymentTermsDays Int      @default(30)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime? @db.Timestamptz(6)

  users    User[]
  trips    Trip[]
  invoices Invoice[]
  rateCards RateCard[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
}

model Vehicle {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id])
  regNo           String
  type            String?
  capacityKg      Int?
  currentOdometer Int
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  trips Trip[]

  @@unique([organizationId, regNo])
  @@index([organizationId])
  @@index([organizationId, active])
}

model Driver {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  phone           String
  licenseNo       String?
  licenseExpiry   DateTime? @db.Timestamptz(6)
  userId          String?   @unique @db.Uuid
  dutyStatus      String?   @default("OFFLINE")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  trips Trip[]

  @@index([organizationId])
  @@index([organizationId, active])
  @@index([organizationId, phone])
}


// ============================================================
// EXECUTION
// ============================================================

model Trip {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @db.Uuid
  organization      Organization @relation(fields: [organizationId], references: [id])
  tripNumber        String
  lrNumber          String?
  status            TripStatus @default(ASSIGNED)
  version           Int        @default(0)
  clientId          String?    @db.Uuid
  client            Client?    @relation(fields: [clientId], references: [id])
  vendorId          String?    @db.Uuid
  vendor            Vendor?    @relation(fields: [vendorId], references: [id])
  routeId           String?    @db.Uuid
  route             Route?     @relation(fields: [routeId], references: [id])
  driverId          String?    @db.Uuid
  driver            Driver?    @relation(fields: [driverId], references: [id])
  vehicleId         String?    @db.Uuid
  vehicle           Vehicle?   @relation(fields: [vehicleId], references: [id])
  origin            String?
  destination       String?
  eta               DateTime?  @db.Timestamptz(6)
  odometerStart     Int?
  odometerEnd       Int?
  delayMinutes      Int        @default(0)
  delayReason       String?
  assignedAt        DateTime?  @db.Timestamptz(6)
  startedAt         DateTime?  @db.Timestamptz(6)
  deliveredAt       DateTime?  @db.Timestamptz(6)
  closedAt          DateTime?  @db.Timestamptz(6)
  auditRequestedAt  DateTime?  @db.Timestamptz(6)
  auditedAt         DateTime?  @db.Timestamptz(6)
  readyForBillingAt DateTime?  @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?  @db.Timestamptz(6)

  tripStops    TripStop[]
  expenses     TripExpense[]
  eodTally     EodTally?
  auditReviews AuditReview[]
  invoiceLine  InvoiceLine?

  @@unique([organizationId, tripNumber])
  @@index([organizationId])
  @@index([status])
  @@index([organizationId, driverId, status])
}

model TripStop {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id])
  tripId         String         @db.Uuid
  trip           Trip           @relation(fields: [tripId], references: [id])
  sequence       Int
  name           String?
  address        String?
  expectedQty    Int?
  deliveredQty   Int?
  collectionType CollectionMode @default(COD)
  expectedCollection Int        @default(0)
  status         TripStopStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  collection   Collection?
  podDocuments PodDocument[]

  @@index([organizationId])
  @@index([tripId, sequence])
}

model PodDocument {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @db.Uuid
  organization      Organization    @relation(fields: [organizationId], references: [id])
  tripStopId        String          @db.Uuid
  tripStop          TripStop        @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  documentType      PodDocumentType
  s3Key             String
  contentType       String
  sizeBytes         Int
  sha256            String?
  signatoryName     String?
  dockGpsLat        Float?
  dockGpsLng        Float?
  gateInTimestamp   DateTime?       @db.Timestamptz(6)
  stampVerified     Boolean         @default(false)
  authHash          String?
  uploadedById      String?         @db.Uuid
  ocrResult         Json?
  validationResult  Json?
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)

  @@index([organizationId])
  @@index([tripStopId])
  @@index([organizationId, documentType])
}


model TripExpense {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  tripId         String      @db.Uuid
  trip           Trip        @relation(fields: [tripId], references: [id])
  type           ExpenseType
  amount         Int
  receiptRef     String?
  note           String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)

  @@index([organizationId])
  @@index([tripId])
}

model EodTally {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  tripId         String   @unique @db.Uuid
  trip           Trip     @relation(fields: [tripId], references: [id])
  toll           Int      @default(0)
  allowance      Int      @default(0)
  fuel           Int      @default(0)
  actualCash     Int      @default(0)
  netExpected    Int      @default(0)
  discrepancy    Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organizationId])
}

model AuditReview {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  tripId         String       @db.Uuid
  trip           Trip         @relation(fields: [tripId], references: [id])
  reviewerId     String?      @db.Uuid
  outcome        AuditOutcome
  checklist      Json?
  notes          String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  @@index([organizationId])
  @@index([tripId])
}

// ============================================================
// FINANCIALS
// ============================================================

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id])
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  version        Int           @default(0)
  clientId       String?       @db.Uuid
  client         Client?       @relation(fields: [clientId], references: [id])
  issueDate      DateTime      @default(now()) @db.Timestamptz(6)
  dueDate        DateTime?     @db.Timestamptz(6)
  periodStart    DateTime?     @db.Timestamptz(6)
  periodEnd      DateTime?     @db.Timestamptz(6)
  subtotal       Int           @default(0)
  gstRate        Int           @default(18)
  gstAmount      Int           @default(0)
  total          Int           @default(0)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?     @db.Timestamptz(6)

  lines    InvoiceLine[]
  payments Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([status, dueDate])
  @@index([clientId])
}

model InvoiceLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoiceId      String   @db.Uuid
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  tripId         String   @unique @db.Uuid
  trip           Trip     @relation(fields: [tripId], references: [id])
  lineAmount     Int
  gstAmount      Int
  totalAmount    Int
  snapshot       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organizationId])
  @@index([invoiceId])
}

model Payment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoiceId      String   @db.Uuid
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  amount         Int
  method         String?
  reference      String?
  paidAt         DateTime @default(now()) @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organizationId])
  @@index([invoiceId])
}

// ============================================================
// NOTIFICATIONS & AUDIT
// ============================================================

model Notification {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id])
  userId         String?           @db.Uuid
  type           NotificationType?
  title          String
  body           String
  payload        Json?
  readAt         DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)

  @@index([organizationId])
  @@index([userId, readAt])
}

model Vendor {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id])
  name             String
  code             String
  gstin            String?
  stateCode        String?
  payoutTermsDays  Int       @default(15)
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime? @db.Timestamptz(6)

  rateCards RateCard[]
  trips     Trip[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
}

model Route {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @db.Uuid
  organization          Organization @relation(fields: [organizationId], references: [id])
  name                  String
  origin                String
  destination           String
  expectedKm            Int
  standardTollEstimate  Int       @default(0)
  status                String    @default("ACTIVE")
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt             DateTime? @db.Timestamptz(6)

  rateCardItems RateCardItem[]
  trips         Trip[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, status])
}

model RateCard {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  organization      Organization @relation(fields: [organizationId], references: [id])
  name              String
  counterpartyType  CounterpartyType
  clientId          String?   @db.Uuid
  client            Client?   @relation(fields: [clientId], references: [id])
  vendorId          String?   @db.Uuid
  vendor            Vendor?   @relation(fields: [vendorId], references: [id])
  validFrom         DateTime  @db.Timestamptz(6)
  validTo           DateTime? @db.Timestamptz(6)
  status            String    @default("ACTIVE")
  notes             String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime? @db.Timestamptz(6)

  items RateCardItem[]

  @@index([organizationId])
  @@index([organizationId, counterpartyType, clientId])
  @@index([organizationId, counterpartyType, vendorId])
  @@index([organizationId, status])
  @@index([organizationId, validFrom, validTo])
}

model RateCardItem {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  rateCardId     String    @db.Uuid
  rateCard       RateCard  @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  rateType       RateType
  routeId        String?   @db.Uuid
  route          Route?    @relation(fields: [routeId], references: [id])
  tripType       String?
  serviceType    String?
  rate           Int       // paise or rupees-per-unit — consistent with spec §30 (INR)
  notes          String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([organizationId])
  @@index([rateCardId])
  @@index([organizationId, rateType])
}

model Collection {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  organization      Organization @relation(fields: [organizationId], references: [id])
  tripStopId        String       @unique @db.Uuid
  tripStop          TripStop     @relation(fields: [tripStopId], references: [id])
  actualAmount      Int
  mode              CollectionMode
  referenceId       String?
  collectedAt       DateTime     @default(now()) @db.Timestamptz(6)
  recordedById      String?      @db.Uuid
  notes             String?
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)

  @@index([organizationId])
}

model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorId        String?   @db.Uuid
  actorRole      String?
  action         String
  entity         String
  entityId       String    @db.Uuid
  beforeJson     Json?
  afterJson      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([organizationId])
  @@index([entity, entityId])
  @@index([actorId])
}

// ============================================================
// IDEMPOTENCY
// ============================================================

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique
  endpoint       String
  responseHash   String
  expiresAt      DateTime @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
}

// ============================================================
// PERMISSIONS
// ============================================================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String
  category    String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([category])
}

model RolePermission {
  role         Role
  permissionId String   @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@id([role, permissionId])
  @@index([role])
}

